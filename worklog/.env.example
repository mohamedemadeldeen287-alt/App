# Copy this file to `.env` and fill in your Supabase project values.
# Find them in: Supabase Dashboard → Project Settings → API.
# Without these, the app runs on a localStorage fallback (single-device only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (optional). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here; keep the PRIVATE key as a server-side Edge Function
# secret (see supabase/functions/send-nudge-push). Without this, in-app and
# local (tab-open) notifications still work; only server push needs it.
VITE_VAPID_PUBLIC_KEY=
